<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.jsnjack.e</id>
  <name>E</name>
  <summary>Edit text and code with AI autocomplete</summary>
  <developer id="com.jsnjack">
    <name>Yauhen Shulitski</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>E is a focused native editor for GNOME with syntax highlighting, search
    and replace, session recovery, language-server support, and automatic inline
    completion from ordered local or remote models.</p>
  </description>
  <launchable type="desktop-id">com.jsnjack.e.desktop</launchable>
  <url type="homepage">https://github.com/jsnjack/e</url>
  <url type="bugtracker">https://github.com/jsnjack/e/issues</url>
  <provides>
    <binary>e</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@">
      <description>
        <p>First public release. It includes inline AI completion with ordered
        model failover, VS Code-style multiple cursors, a project sidebar,
        Quick Open, a live Markdown preview, language-server completion, and
        session recovery that saves unsaved text a few seconds after each
        edit.</p>
      </description>
    </release>
  </releases>
</component>
